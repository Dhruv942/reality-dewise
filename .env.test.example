# Copy to .env.test and point DATABASE_URL at a THROWAWAY database: every test run truncates users, teams, customers and properties.
NODE_ENV=test
PORT=0
DATABASE_URL=postgres://user@localhost:5432/realestate_crm_auth_test
JWT_SECRET=test-secret-test-secret-test-secret-123456
LOGIN_RATE_LIMIT_MAX=1000
# The CORS tests expect exactly this origin.
CORS_ORIGINS=https://crm.example.com
