# Defaults to "production" when unset; use "development" locally (enables /test-console).
NODE_ENV=development
PORT=3000
# Managed databases: append ?sslmode=require
DATABASE_URL=postgres://user@localhost:5432/realestate_crm_auth
DB_POOL_MAX=10

# Generate with: openssl rand -hex 48  (min 32 chars)
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Browser origins allowed to call the API (comma-separated). Leave empty for same-origin only.
CORS_ORIGINS=
# Number of reverse proxies in front of the app (e.g. 1 on most PaaS) so rate limiting sees the real client IP.
# TRUST_PROXY=1
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Seed script (npm run seed / npm run seed:prod). No defaults are built in: set these yourself.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_EXECUTIVE_EMAIL=amit@example.com
SEED_EXECUTIVE_NAME=Amit
SEED_EXECUTIVE_USERNAME=amit
SEED_EXECUTIVE_PASSWORD=
