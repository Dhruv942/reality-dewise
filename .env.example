NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user@localhost:5432/realestate_crm_auth

# Generate with: openssl rand -hex 48  (min 32 chars)
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Seed script (npm run seed). No defaults are built in: set these yourself.
# Development example only: use strong, unique values anywhere else.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=
SEED_EXECUTIVE_EMAIL=amit@example.com
SEED_EXECUTIVE_NAME=Amit
SEED_EXECUTIVE_PASSWORD=
