# Defaults to "production" when unset; use "development" locally (enables /test-console).
NODE_ENV=development
PORT=4000
# Managed databases: append ?sslmode=require
DATABASE_URL=postgres://user@localhost:5432/realestate_crm_auth
DB_POOL_MAX=10

# Generate with: openssl rand -hex 48  (min 32 chars)
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Browser origins allowed to call the API (comma-separated). Leave empty for same-origin only.
CORS_ORIGINS=
# Number of reverse proxies in front of the app (e.g. 1 on most PaaS) so rate limiting sees the real client IP.
# TRUST_PROXY=1
# Lead timeout: a lead still INCOMING after the admin-set timeout (default 90 min, 24/7) is reassigned. The sweep runs in the API process.
# LEAD_TIMEOUT_JOB_ENABLED=true
# LEAD_TIMEOUT_CHECK_INTERVAL_SECONDS=60
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Seed script (npm run seed / npm run seed:prod). No defaults are built in: set these yourself.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# Optional: leave SEED_MANAGER_PASSWORD empty to skip the manager. The manager leads SEED_TEAM_NAME and the executive joins it.
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_NAME=Manager
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=
SEED_TEAM_NAME=Sales Team
SEED_EXECUTIVE_EMAIL=amit@example.com
SEED_EXECUTIVE_NAME=Amit
SEED_EXECUTIVE_USERNAME=amit
SEED_EXECUTIVE_PASSWORD=
# Optional extra executives (leave the password empty to skip). All executives join SEED_TEAM_NAME.
SEED_EXECUTIVE_2_EMAIL=rahul@example.com
SEED_EXECUTIVE_2_NAME=Rahul
SEED_EXECUTIVE_2_USERNAME=rahul
SEED_EXECUTIVE_2_PASSWORD=
SEED_EXECUTIVE_3_EMAIL=priya@example.com
SEED_EXECUTIVE_3_NAME=Priya
SEED_EXECUTIVE_3_USERNAME=priya
SEED_EXECUTIVE_3_PASSWORD=
